# ===========================================
# lego-store: environment variables
# ===========================================
# Copy to .env.local (gitignored) and fill in. `next dev`, the Prisma CLI, the
# seed and the integration tests all read .env.local, then .env.
# The values below work as-is with `npm run db:up` (docker-compose.yml).

# --- Database (PostgreSQL) -------------------------------------------------
# Dev database. docker-compose publishes Postgres on host port 5433
# (POSTGRES_PORT to change it) so it never clashes with a local 5432.
DATABASE_URL="postgresql://lego:lego@localhost:5433/lego_store"
# Test database for the Vitest integration project: WIPED on every run.
# Its name must contain "test".
DATABASE_URL_TEST="postgresql://lego:lego@localhost:5433/lego_store_test"

# --- Auth (Auth.js) --------------------------------------------------------
# REQUIRED. Secret that signs session tokens. Without it nobody can log in
# (/login says so). Generate one: `npx auth secret`
# or `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
AUTH_SECRET=
# `next start` outside Vercel: Auth.js only trusts the request's host when told
# to (Vercel does it implicitly). Set this, or AUTH_URL, for a self-hosted or
# local production server.
# AUTH_TRUST_HOST=true
# Public URL of the app; only needed behind a proxy or outside Vercel.
# AUTH_URL="http://localhost:3000"
# Self-hosted behind your own reverse proxies (not Vercel): how many of them
# append to X-Forwarded-For. Rate limits then key by the entry the outermost
# one added. Unset/0: no client IP is trusted (fine for local dev; a public
# server without it applies the per-IP limits to all visitors together).
# TRUSTED_PROXY_HOPS=1
# Google sign-in, optional: the button only shows up when both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Admin user, created by `npm run db:seed` (or by a first Google sign-in with
# that address verified by Google). The public register form refuses this
# email, since it does not verify addresses. Set both or neither; empty counts as unset. Password: at
# least 8 characters. With neither, no admin is created, unless you opt in to
# the dev-only admin admin@lego-store.local / admin-dev-1234 (public password)
# with SEED_DEV_ADMIN=1, on your machine only. Never with NODE_ENV=production.
# Seeding a real admin (or none) demotes that dev admin if it exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SEED_DEV_ADMIN=1

# --- Payments (Stripe, test mode) ------------------------------------------
# All three are needed; without them, checkout says payments are not
# configured (and lists what is missing, in development).
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint. Local: printed by
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Production: the endpoint's secret in the Stripe dashboard (events
# payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled).
STRIPE_WEBHOOK_SECRET=
# Tests only: an in-memory stand-in for Stripe (test cards instead of the
# Payment Element; webhooks must still be signed with STRIPE_WEBHOOK_SECRET).
# Ignored when NODE_ENV=production. Playwright sets it for its own dev server.
# STRIPE_MOCK=1

# --- Scheduled jobs ----------------------------------------------------------
# Bearer token of GET /api/cron/expire-orders (cancels checkouts left pending
# for a day). Vercel Cron sends it by itself; without it the route is off.
# Generate one like AUTH_SECRET.
CRON_SECRET=

# --- Email (Resend) --------------------------------------------------------
# Without both, emails are logged to the console instead of sent.
# Without a verified domain, Resend only delivers to the account owner.
RESEND_API_KEY=
# Sender, e.g. "LEGO Store <pedidos@tu-dominio.com>".
EMAIL_FROM=

# --- Site --------------------------------------------------------------------
# Absolute URL of the site (emails, Stripe return URLs, metadata).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
