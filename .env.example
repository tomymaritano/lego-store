# ===========================================
# lego-store: environment variables
# ===========================================
# Copy to .env.local (gitignored) and fill in. `next dev`, the Prisma CLI, the
# seed and the integration tests all read .env.local, then .env.
# The values below work as-is with `npm run db:up` (docker-compose.yml): for a
# local store you only need to set AUTH_SECRET (and SEED_DEV_ADMIN=1 for an admin).
# Reference with production notes: docs/deploy.md ("Variables de entorno").

# --- Database (PostgreSQL) -------------------------------------------------
# Dev database. docker-compose publishes Postgres on host port 5433
# (POSTGRES_PORT to change it) so it never clashes with a local 5432.
DATABASE_URL="postgresql://lego:lego@localhost:5433/lego_store"
# Test database for the Vitest integration project: WIPED on every run.
# Its name must contain "test".
DATABASE_URL_TEST="postgresql://lego:lego@localhost:5433/lego_store_test"

# --- Auth (Auth.js) --------------------------------------------------------
# REQUIRED. Secret that signs session tokens. Without it nobody can log in
# (/login says so). Generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
# or `openssl rand -base64 32`. (Not `npx auth secret`: on npm, `auth` is now
# another project's CLI and prints a different variable.)
AUTH_SECRET=
# `next start` outside Vercel: Auth.js only trusts the request's host when told
# to (Vercel does it implicitly). Set this, or AUTH_URL, for a self-hosted or
# local production server.
# AUTH_TRUST_HOST=true
# Public URL of the app; only needed behind a proxy or outside Vercel.
# AUTH_URL="http://localhost:3000"
# Self-hosted behind your own reverse proxies (not Vercel): how many of them
# append to X-Forwarded-For. Rate limits then key by the entry the outermost
# one added. Unset/0: no client IP is trusted (fine for local dev; a public
# server without it applies the per-IP limits to all visitors together, so one
# abuser can block login/sign-up/guest checkout for everyone; a production
# server logs a warning at startup when neither this nor VERCEL=1 is set).
# TRUSTED_PROXY_HOPS=1
# Google sign-in, optional: the button only shows up when both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Admin user, created by `npm run db:seed` (or by a first Google sign-in with
# that address verified by Google). The public register form refuses this
# email, since it does not verify addresses. Set both or neither; empty counts as unset. Password: at
# least 8 characters. With neither, no admin is created, unless you opt in to
# the dev-only admin admin@lego-store.local / admin-dev-1234 (public password)
# with SEED_DEV_ADMIN=1, on your machine only. Never with NODE_ENV=production.
# Seeding a real admin (or none) demotes that dev admin if it exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SEED_DEV_ADMIN=1

# --- Payments ----------------------------------------------------------------
# Who takes new orders' payments: "mercadopago" (default) or "stripe". Each
# order keeps its provider, so set up Stripe too while old Stripe orders may
# still need a refund.
# PAYMENT_PROVIDER=mercadopago

# --- Mercado Pago (main provider) ---------------------------------------------
# All three are needed; without them, checkout says payments are not
# configured (and lists what is missing, in development).
# Credentials: https://www.mercadopago.com.ar/developers/panel/app (Tus
# integraciones > your app > Credenciales de prueba / de producción).
# A TEST-... access token (or a test seller's) runs against Mercado Pago's sandbox.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# The webhook's secret key ("Clave secreta", Tus integraciones > Webhooks >
# Configurar notificaciones, event "Pagos", URL
# https://<your-domain>/api/webhooks/mercadopago). Mercado Pago cannot reach
# localhost: locally, use a tunnel and set NEXT_PUBLIC_SITE_URL to its https URL
# (it is also where Checkout Pro returns), or rely on the return page and the
# cleanup (docs/payments.md, "Webhooks en tu máquina").
MERCADOPAGO_WEBHOOK_SECRET=

# --- Stripe (alternative provider, test mode) --------------------------------
# All three are needed for Stripe; without them a Stripe checkout says payments
# are not configured (and lists what is missing, in development).
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint. Local: printed by
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Production: the endpoint's secret in the Stripe dashboard (events
# payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled,
# charge.refunded).
# With TEST keys (sk_test_/pk_test_) here, `npm run test:e2e:stripe` also runs the
# checkout against real Stripe test mode (e2e/stripe-live; skipped without them).
STRIPE_WEBHOOK_SECRET=
# Tests only: in-memory stand-ins for Mercado Pago and Stripe (test options
# instead of the Payment Brick / Payment Element; webhooks must still be signed
# with MERCADOPAGO_WEBHOOK_SECRET / STRIPE_WEBHOOK_SECRET). STRIPE_MOCK=1, its
# older name, works too. Ignored when NODE_ENV=production and by any
# `next build` output, whatever NODE_ENV it is started with; a server running it
# logs a warning at startup. Playwright sets it for its own dev server.
# PAYMENTS_MOCK=1

# --- Scheduled jobs ----------------------------------------------------------
# Bearer token of GET /api/cron/expire-orders (cancels checkouts left pending
# for a day). Vercel Cron sends it by itself; without it the route is off.
# Generate one like AUTH_SECRET.
CRON_SECRET=

# --- Email (Resend) --------------------------------------------------------
# Without both, emails are logged to the console instead of sent.
# Without a verified domain, Resend only delivers to the account owner.
RESEND_API_KEY=
# Sender, e.g. "LEGO Store <pedidos@tu-dominio.com>".
EMAIL_FROM=
# Where the store's notices go (a new contact message). Unset: the contact
# email of /admin/configuracion.
# STORE_NOTIFY_EMAIL=

# --- Uploads (admin pictures) --------------------------------------------------
# Vercel Blob read-write token: with it, uploads go to the Blob store (production).
# Without it they are written to public/uploads (gitignored) on this server; on
# Vercel without it uploads are off (admins paste URLs instead).
BLOB_READ_WRITE_TOKEN=
# Dev/test only: another folder for local uploads instead of public/uploads.
# UPLOADS_DIR=

# --- Site --------------------------------------------------------------------
# Absolute URL of the site: canonical/Open Graph URLs, the sitemap, links in
# emails, Mercado Pago's back_urls and notification_url, Stripe return URLs.
# Inlined at build time (NEXT_PUBLIC_): rebuild after changing it.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Tooling (optional) ----------------------------------------------------------
# Host port of the Docker Postgres (default 5433); read by docker compose from
# the shell, not from this file: `POSTGRES_PORT=5434 npm run db:up`, then fix the
# URLs above.
# Ports of Playwright's dev and production servers (defaults 3000 and 3100),
# also from the shell only, to run the e2e suite next to other servers:
# `E2E_DEV_PORT=3010 E2E_PROD_PORT=3110 npx playwright test`.
